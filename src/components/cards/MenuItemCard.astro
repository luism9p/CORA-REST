---
import { Image } from "astro:assets";
import Lightbox from "@components/media/Lightbox.vue";
import { getLangFromUrl } from "@util/translate";

interface MenuItem {
  id: string;
  translations: Record<string, { name: string; description: string }>;
  prices: { label: string; amount: number }[];
  allergens: string[];
}

interface Props {
  content: MenuItem;
  show_offer?: boolean;
  accent?: string;
}
const blok = Astro.props;
let { content } = blok;

// Extract Spanish translation as default
const translation = content.translations?.es || { name: "", description: "" };

const prices = content.prices || [];
const normalPrices = prices; 
const show_price = normalPrices && normalPrices.length > 0;
const alergenos = content.allergens || [];

const getLayout = () => {
  let cls = "card";
  // Keeping image check in case it's added back to the schema later
  if ((content as any).image?.id) {
    cls += "-image";
  }
  if (translation.description) {
    cls += "-intro";
  }
  if (
    alergenos &&
    alergenos.length > 0
  ) {
    cls += "-tags";
  }
  if (normalPrices && normalPrices.length > 1) {
    cls += "-price";
  }

  return cls;
};
---

<div class={`dish-card menu-item relative grid offer ${getLayout()} h-fit`} data-allergens={JSON.stringify(content.allergens || [])}>
  {
    (content as any).image?.id && (
      <div class="image">
        <Lightbox
          className="aspect-square overflow-hidden rounded-full block transition-all    "
          client:visible
          src={(content as any).image.filename}
        >
          <Image
            src={(content as any).image.filename}
            alt={translation.name}
            width={80}
            height={80}
            decoding="async"
            loading="lazy"
            class="object-cover w-full h-full"
          />
        </Lightbox>
      </div>
    )
  }

  <div class="info">
    <h3 class="font-base line-clamp-5 flex w-full text-lg md:text-xl font-bold leading-snug text-gray-900 dark:text-white">
      <span>
        <span class="i18n-element" data-translations={JSON.stringify(content.translations)} data-key="name">{translation.name}</span>

        {
          (content as any).labels && (content as any).labels.length > 0 && (
            <div class="flex gap-2 ml-2 items-center">
              {(content as any).labels.map((name: string) => (
                <span class="text-[10px] uppercase font-bold tracking-wider bg-primary text-white px-2 py-0.5 rounded-full">
                  {name}
                </span>
              ))}
            </div>
          )
        }
      </span>

      <div class="flex-grow border-b border-current opacity-65"></div>
    </h3>

    {
      content.translations && (
        <div class="max-w-lg pt-1">
          <div
            id={`desc-${content.id}`}
            class="dish-desc i18n-element line-clamp-2 text-sm leading-snug text-gray-600 transition-[max-height] duration-300 ease-in-out dark:text-gray-400"
            data-translations={JSON.stringify(content.translations)}
            data-key="description"
          >
            {translation.description}
          </div>
          <button
            type="button"
            class="desc-toggle mt-1 text-xs font-bold text-primary transition-opacity duration-150 active:opacity-60"
            aria-expanded="false"
            aria-controls={`desc-${content.id}`}
            hidden
          >
            Ver más
          </button>
        </div>
      )
    }
  </div>
  {
    alergenos && alergenos.length > 0 && (
      <div class="tags flex w-full flex-wrap items-end justify-end gap-2 mt-3">
        {alergenos.map((alergeno) => (
          <span class="text-[10px] md:text-xs uppercase font-bold tracking-wider bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 px-2 py-1 rounded-md">
            {alergeno}
          </span>
        ))}
      </div>
    )
  }

  {
    show_price && (
      <div
        class={`price flex flex-col md:flex-row md:flex-wrap md:items-center justify-end gap-1 pr-4 md:pr-0 ${normalPrices && normalPrices.length > 1 ? "mt-2" : ""}`}
      >
        {normalPrices.map((price) => (
          <span class="flex items-center gap-1 text-sm md:text-base font-bold">
            {price.label && <span class="text-xs md:text-sm font-normal text-gray-500 mr-0.5">{price.label}</span>}
            <div class="flex items-baseline gap-0.5 whitespace-nowrap">
              <span class="currency-symbol text-sm font-medium text-gray-900 dark:text-white">S/</span>
              <span class="price-value text-lg font-bold text-gray-900 dark:text-white" data-base-price={price.amount}>{price.amount.toFixed(2)}</span>
            </div>
          </span>
        ))}
      </div>
    )
  }
</div>

<style lang="postcss">
    .menu-item {
        @apply grid gap-y-2 gap-x-4 max-w-lg md:max-w-full mx-auto w-full;

        grid-template-columns: 1fr 1fr min(6.5rem, 25vw);
        grid-auto-rows: auto;
        grid-template-areas: 
        "💁 💁 💲" ;

        &.card, &.card-intro {
            grid-template-columns: 1fr 1fr auto; 
        }
        &.card-image {
            grid-template-rows: auto 1fr;
            @apply row-span-1 sm:col-span-2 lg:col-span-1;
            grid-template-areas: 
        "💁 💁 📷" 
        "💲 💲 📷";  
        }
        &.card-image-intro {
            @apply row-span-2 sm:col-span-2 lg:col-span-1;
            grid-template-rows: auto 1fr;
            grid-template-areas: 
        "💁 💁 📷" 
        "💁 💁 💲";  
        }

         &.card-image-tags  {
            grid-template-rows: auto 1.2rem auto 1fr;
            @apply row-span-1 sm:col-span-2 lg:col-span-1;
            grid-template-areas: 
        "💁 💁 📷" 
        "💲 💲 📷" 
        "🌞 🌞 📷" 
        ". . 📷";
        }

        &.card-image-intro-tags-price  {
            
            @apply row-span-2 sm:col-span-2 lg:col-span-1;
            grid-template-areas: 
        "💁 💁 📷" 
        "💁 💁 🌞"
        "💲 💲 💲";
        }

        &.card-image-intro-tags  {
            
            @apply row-span-2 sm:col-span-2 lg:col-span-1;
            grid-template-areas: 
        "💁 💁 📷" 
        "🌞 🌞 💲";
        }

        &.card-intro-tags {
            @apply row-span-1;
            grid-template-columns: 1fr 1fr auto; 
            grid-template-areas: 
        "💁 💁 💲" 
        "🌞 🌞 🌞";
        }



        &.card-intro-tags-price  {
            
            @apply sm:col-span-2 lg:col-span-1;
            grid-template-areas: 
        "💁 💁 💲" 
        "💁 💁 💲" 
        "🌞 🌞 🌞";
        } 

        &.card-intro-price {
            @apply sm:col-span-2 lg:col-span-1 ;
            grid-template-areas: 
        "💁 💁 💲" 
        "💁 💁 💲";
        } 

          &.card-image-intro-price  {
            
            @apply row-span-2 sm:col-span-2 lg:col-span-1;
            grid-template-areas: 
        "💁 💁 📷" 
        "💁 💁 🌞" 
        "💲 💲 💲";
        }

        &.card-tags {
            @apply row-span-1;
            grid-template-columns: 1fr 1fr auto; 
            grid-template-areas: 
        "💁 💁 💲" 
        "🌞 🌞 🌞";
        }

         &.card-image-price {        
            @apply row-span-2 sm:col-span-2 lg:col-span-1;
            grid-template-areas: 
        "💁 💁 📷" 
        "💲 💲 📷";

        }

        &.card-price {
            
            @apply row-span-1;
            grid-template-areas: 
        "💁 💁 💁" 
        "💲 💲 💲";

        }

 
        .price {
            grid-area: 💲;
            align-self: start;
            padding-top: 0.125rem;
        }
        .image {
            grid-area: 📷;
        }
        .info {
            grid-area: 💁;
            @apply text-balance;
        }
        .tags {
            grid-area: 🌞;
        }
    }

</style>

<script>
  // "Ver más / Ver menos" para la descripción del plato. Un solo listener
  // delegado por página (Astro dedupea este <script> aunque el componente
  // se repita decenas de veces en el menú).
  const LABELS: Record<string, { more: string; less: string }> = {
    es: { more: "Ver más", less: "Ver menos" },
    en: { more: "Read more", less: "Read less" },
    fr: { more: "Voir plus", less: "Voir moins" },
    it: { more: "Leggi di più", less: "Leggi meno" },
    de: { more: "Mehr anzeigen", less: "Weniger anzeigen" },
  };

  function currentLang() {
    return localStorage.getItem("preferredLanguage") || "es";
  }

  function labelFor(expanded: boolean) {
    const dict = LABELS[currentLang()] || LABELS.es;
    return expanded ? dict.less : dict.more;
  }

  // Mide la altura real de 2 líneas y la altura completa, quitando y
  // reponiendo el clamp en el mismo tick (sin parpadeo visual).
  function measure(desc: HTMLElement) {
    desc.classList.remove("line-clamp-2");
    const full = desc.scrollHeight;
    desc.classList.add("line-clamp-2");
    const collapsed = desc.clientHeight;
    return { full, collapsed };
  }

  function setupToggle(btn: HTMLButtonElement) {
    if (btn.dataset.descInit === "true") return;
    btn.dataset.descInit = "true";

    const desc = document.getElementById(btn.getAttribute("aria-controls") || "");
    if (!desc) return;

    const { full, collapsed } = measure(desc);

    // El texto ya cabe en 2 líneas: no hace falta el botón.
    if (full <= collapsed + 2) {
      btn.remove();
      return;
    }

    desc.style.overflow = "hidden";
    desc.style.maxHeight = `${collapsed}px`;
    btn.hidden = false;
    btn.textContent = labelFor(false);

    // Limpieza al terminar la transición: deja la descripción en un estado
    // "natural" (sin alturas fijas en píxeles) para que no se rompa si el
    // contenido cambia después (idioma, resize, etc). Se dispara por
    // transitionend, pero también por un respaldo en caso de que ese evento
    // no llegue (transiciones desactivadas, prefers-reduced-motion, pestaña
    // en segundo plano...).
    let cleanupToken = 0;
    function scheduleCleanup() {
      const token = ++cleanupToken;
      const done = () => {
        if (token !== cleanupToken) return; // ya se disparó otro toggle antes
        if (btn.getAttribute("aria-expanded") === "true") {
          desc.style.maxHeight = "none";
        } else {
          desc.classList.add("line-clamp-2");
          desc.style.maxHeight = "";
          desc.style.overflow = "";
        }
      };
      desc.addEventListener("transitionend", done, { once: true });
      setTimeout(done, 400);
    }

    btn.addEventListener("click", () => {
      const expanded = btn.getAttribute("aria-expanded") === "true";
      cleanupToken++; // invalida cualquier limpieza pendiente de un toggle anterior

      if (expanded) {
        // Colapsar: fija la altura completa actual antes de animar hacia abajo.
        desc.style.maxHeight = `${desc.scrollHeight}px`;
        void desc.offsetHeight;
        // setTimeout en vez de requestAnimationFrame: sigue disparando aunque
        // la pestaña esté en segundo plano (rAF se pausa ahí).
        setTimeout(() => {
          desc.classList.remove("line-clamp-2");
          desc.style.maxHeight = `${collapsed}px`;
          scheduleCleanup();
        }, 10);
      } else {
        // Expandir: quita el clamp y anima hacia la altura completa real.
        desc.classList.remove("line-clamp-2");
        desc.style.maxHeight = `${desc.scrollHeight}px`;
        scheduleCleanup();
      }

      btn.setAttribute("aria-expanded", String(!expanded));
      btn.textContent = labelFor(!expanded);
    });
  }

  function initDescToggles() {
    document.querySelectorAll<HTMLButtonElement>(".desc-toggle").forEach(setupToggle);
  }

  function updateToggleLabels() {
    document.querySelectorAll<HTMLButtonElement>(".desc-toggle:not([hidden])").forEach((btn) => {
      btn.textContent = labelFor(btn.getAttribute("aria-expanded") === "true");
    });
  }

  window.addEventListener("languageChanged", updateToggleLabels);

  document.addEventListener("astro:page-load", initDescToggles);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDescToggles);
  } else {
    initDescToggles();
  }
</script>

