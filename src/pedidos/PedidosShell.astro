---
// src/pedidos/PedidosShell.astro
// Shell HTML propio del módulo de pedidos. A propósito NO reutiliza
// src/layouts/Layout.astro (trae el header/footer/QR de la carta y el
// globals.css completo del sitio) ni importa globals.css — el módulo se
// mantiene aislado del resto de CORA tal como pide el requerimiento.
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
